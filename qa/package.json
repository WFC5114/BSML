{
  "name": "bsml-qa",
  "private": true,
  "description": "Automated QA for the BSML website: end-to-end, languages, accessibility, copy guardrails, China-safe dependencies, performance budgets.",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:fixture": "node fixtures/build-fixture.mjs && QA_SITE_DIR=fixtures/sample-site playwright test",
    "copy-guard": "node scripts/copy-guard.mjs",
    "lighthouse": "lhci autorun --config=lighthouserc.cjs",
    "serve": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.56.1"
  }
}
